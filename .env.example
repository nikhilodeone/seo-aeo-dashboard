# Everything here is OPTIONAL. The dashboard works with none of it:
# it crawls your site and any competitor URLs you add.

# --- Rankings, People-Also-Ask, automatic competitor discovery ---
# Get a key at https://serper.dev  (Google SERP API)
SERPER_API_KEY=
# Results per query. 20 lets the dashboard see page 2 ("striking distance").
# Set to 10 if your Serper plan bills more for larger result sets.
SERPER_NUM=20

# --- AI content briefs + competitor/question suggestions ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Protect your deployment (recommended on Vercel) ---
# If set, every API call needs this passcode (the UI asks for it once per tab).
# Without it, anyone with your URL can spend your Serper/Anthropic credits.
DASHBOARD_PASSCODE=

# --- Crawler behaviour ---
# Identify the crawler to site owners. Put your own contact URL here.
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; SEOGapBot/1.0; +https://github.com/your-username/seo-aeo-dashboard)
# Set to true to ignore robots.txt Disallow rules (only for sites you own).
CRAWL_IGNORE_ROBOTS=false
# DEV ONLY: allow crawling localhost / private IPs. Never enable in production.
ALLOW_PRIVATE_HOSTS=false
